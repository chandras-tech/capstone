# Supabase — copy the "URI" from your project Settings → Database → Connection string
# Add ?sslmode=require at the end if you see SSL errors
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# JWT — use any long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend URL (for CORS) — http://localhost:3000 in dev
FRONTEND_URL=http://localhost:3000
